<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bingo 75 Boa Vista</title><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><style>body{background:#0f172a;color:#fff;font-family:Arial;text-align:center;padding:10px;margin:0}#bola{font-size:80px;font-weight:900;color:#22c55e;background:#1e293b;border-radius:20px;padding:20px;margin:10px auto;max-width:300px}.carton{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;max-width:400px;margin:15px auto}.num{background:#1e293b;padding:16px 5px;border-radius:10px;font-weight:bold}.marcado{background:#22c55e!important;color:#000}.gratis{background:#f59e0b;color:#000}button{background:#22c55e;border:0;padding:16px 24px;border-radius:12px;font-weight:800;font-size:18px;margin:5px;color:#000}#lista{display:flex;flex-wrap:wrap;justify-content:center;gap:4px;max-width:400px;margin:auto}.bolita{background:#334155;padding:6px 10px;border-radius:20px;font-size:12px}</style></head><body><h2>BINGO 75 - BOA VISTA</h2><div id="bola">-</div><p id="estado">Conectando...</p><div id="lista"></div><button onclick="cantar()">CANTAR BOLA</button><button onclick="reiniciar()">REINICIAR</button><button onclick="generar()">NUEVO CARTÓN</button><div id="carton" class="carton"></div><script>const S_URL="https://fueinabwnlswcahofcjq.supabase.co";const S_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ1ZWluYWJ3bmxzd2NhaG9mY2pxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk0NDY1MjgsImV4cCI6MjA3NTAyMjUyOH0.mF3pPoaY8yHUyLpgd8tYqYzW8Wk-3R7hX8Y8a9b0c1d2";const supa=supabase.createClient(S_URL,S_KEY);let cantados=[];let miCarton=[[],[],[],[],[]];function generar(){let c=[[],[],[],[],[]];for(let i=0;i<5;i++){let min=i*15+1,max=min+14,s=new Set();while(s.size<5)s.add(Math.floor(Math.random()*(max-min+1))+min);c[i]=[...s]}miCarton=c;render()}function render(){let h="";for(let r=0;r<5;r++)for(let col=0;col<5;col++){let n=miCarton[col][r];let free=r==2&&col==2;let txt=free?"FREE":n;let mk=cantados.includes(n)||free?"marcado":"";let gf=free?"gratis":"";h+=`<div class="num ${mk} ${gf}" onclick="this.classList.toggle('marcado')">${txt}</div>`}document.getElementById('carton').innerHTML=h;let lb="";cantados.forEach(b=>lb+=`<span class="bolita">${b}</span>`);document.getElementById('lista').innerHTML=lb}async function load(){let {data}=await supa.from('salas').select('*').eq('id','sala1').single();if(data&&data.numeros_cantados){cantados=data.numeros_cantados;document.getElementById('bola').innerText=cantados.slice(-1)[0]||"-";document.getElementById('estado').innerText=`Bolas: ${cantados.length}/75`;render()}}async function cantar(){let disp=[];for(let i=1;i<=75;i++)if(!cantados.includes(i))disp.push(i);if(!disp.length)return alert("Bingo lleno!");let n=disp[Math.floor(Math.random()*disp.length)];cantados.push(n);await supa.from('salas').update({numeros_cantados:cantados}).eq('id','sala1')}async function reiniciar(){if(!confirm("Reiniciar juego?"))return;cantados=[];await supa.from('salas').update({numeros_cantados:[]}).eq('id','sala1');load()}supa.channel('bingo').on('postgres_changes',{event:'*',schema:'public',table:'salas',filter:'id=eq.sala1'},p=>{cantados=p.new.numeros_cantados;load()}).subscribe();generar();load();</script></body></html>
